@page "/Error"
@using System.Diagnostics

<PageTitle>خطا</PageTitle>

<h1 class="text-danger">خطا.</h1>
<h2 class="text-danger">هنگام پردازش درخواست شما خطایی رخ داد.</h2>

@if (ShowRequestId)
{
    <p>
        <strong>شناسهٔ درخواست:</strong> <code dir="ltr">@RequestId</code>
    </p>
}

<h3>حالت توسعه</h3>
<p>
    با تغییر به محیط <strong dir="ltr">Development</strong>، اطلاعات دقیق‌تری دربارهٔ خطای رخ‌داده نمایش داده می‌شود.
</p>
<p>
    <strong>محیط توسعه (Development) نباید برای کاربردهای مستقرشده فعال شود.</strong>
    چنین کاری ممکن است باعث افشای اطلاعات حساسِ نهفته در استثناها به کاربران نهایی شود.
    برای اشکال‌زدایی محلی، با تنظیم متغیر محیطی <strong dir="ltr">ASPNETCORE_ENVIRONMENT</strong> روی مقدار <strong dir="ltr">Development</strong> و راه‌اندازی مجدد کاربرد، این محیط را فعال کنید.
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
