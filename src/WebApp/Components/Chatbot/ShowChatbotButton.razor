@using eShop.WebApp.Components.Chatbot
@inject IStringLocalizer<SharedResources> L

<button type="button" class="show-chatbot" data-chat-toggle data-chat-eyes aria-controls="chatbot-pane" aria-expanded="false" title="@(L["Chatbot_Open"])" aria-label="@(L["Chatbot_Open"])">
    <span class="chatbot-eyes" aria-hidden="true">
        <span class="chatbot-eye">
            <svg class="chatbot-pupil" viewBox="0 0 20 32" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 6 Q 4 16 12 26" />
            </svg>
        </span>
        <span class="chatbot-eye">
            <svg class="chatbot-pupil" viewBox="0 0 20 32" xmlns="http://www.w3.org/2000/svg">
                <path d="M8 6 Q 16 16 8 26" />
            </svg>
        </span>
    </span>
</button>

<div class="chatbot-dock" data-chat-dock>
    <Chatbot />
</div>
