@model LogoutViewModel

<div class="logout-page">
    <div class="lead">
        <h1>خروج از سیستم</h1>
        <p>آیا مایلید از <span dir="ltr">IdentityServer</span> خارج شوید؟</p>
    </div>

    <form asp-action="Logout">
        <input type="hidden" name="logoutId" value="@Model.LogoutId"  />
        <div class="form-group">
            <button class="btn btn-primary">بله</button>
        </div>
    </form>
</div>
