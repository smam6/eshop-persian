@model LoginViewModel

<div class="login-page">
    @if (Model.EnableLocalLogin)
    {
        <aside class="login-visual" aria-hidden="true">
            <div class="login-visual-inner">
                <p class="login-visual-kicker">AdventureWorks</p>
                <p class="login-visual-line">برای ماجرای بعدی آماده شوید.</p>
            </div>
        </aside>

        <section class="login-card" aria-labelledby="login-title">
            <div class="login-card-header">
                <h1 id="login-title">ورود</h1>
            </div>

            <form asp-route="Login" class="login-form">
                <input type="hidden" asp-for="ReturnUrl" />
                <partial name="_ValidationSummary" />

                <div class="form-group">
                    <label asp-for="Username"></label>
                    <input class="form-control" placeholder="نام کاربری" asp-for="Username" autofocus>
                    <span asp-validation-for="Username" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password"></label>
                    <input type="password" class="form-control" placeholder="گذرواژه" asp-for="Password" autocomplete="off">
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>

                @if (Model.AllowRememberLogin)
                {
                    <div class="form-group form-group-check">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="RememberLogin">
                            <label class="form-check-label" asp-for="RememberLogin">
                                مرا به خاطر بسپار
                            </label>
                        </div>
                    </div>
                }

                <p class="login-hint">کاربرهای نمونه <span dir="ltr">alice/bob</span> با گذرواژهٔ <span dir="ltr">Pass123$</span> هستند.</p>

                <button class="btn btn-primary login-submit" name="button" value="login">ورود</button>
            </form>
        </section>
    }
</div>